# Copy to fly.toml and replace the app name before deploying.
app = "replace-with-a-unique-app-name"
primary_region = "cdg"

[build]
  dockerfile = "Dockerfile"

[env]
  PORT = "8080"
  TRUST_PROXY = "1"
  MAX_RUNNING_JOBS = "1"
  MAX_QUEUED_JOBS = "2"
  RENDER_TTL_MINUTES = "60"
  RENDER_TIMEOUT_MINUTES = "480"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

[[vm]]
  memory = "8gb"
  cpu_kind = "shared"
  cpus = 4
